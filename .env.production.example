# ==============================================================================
# Bytherix EAM — Production Environment Configuration (.env.production)
# Security Notice: NEVER commit actual production secrets to source control.
# Copy this file to .env on your production host and populate all required values.
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=False
PROJECT_NAME="Bytherix EAM"
API_V1_STR="/api/v1"
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Domain & Ingress
FRONTEND_URL=https://app.bytherix.com
BACKEND_URL=https://api.bytherix.com
ALLOWED_HOSTS=["app.bytherix.com", "api.bytherix.com", "localhost"]
CORS_ORIGINS=["https://app.bytherix.com", "https://api.bytherix.com"]

# High-Availability PostgreSQL 16 + pgvector Database
POSTGRES_DB=bytherix_eam_prod
POSTGRES_USER=bytherix_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://bytherix_admin:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/bytherix_eam_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis 7 (Rate Limiting, DLP Cache, & Celery Broker)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# AWS S3 / Cloudflare R2 Document Object Storage
# For AWS S3: set S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com
# For MinIO in Docker: leave as http://minio:9000
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=REPLACE_WITH_IAM_ACCESS_KEY_ID
S3_SECRET_KEY=REPLACE_WITH_IAM_SECRET_ACCESS_KEY
S3_BUCKET_NAME=bytherix-enterprise-documents-prod
S3_REGION_NAME=us-east-1

# LLM Providers (OpenAI & Anthropic)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-enterprise

# Stripe Billing & Subscription Webhooks
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LIVE_STRIPE_WEBHOOK_SECRET
STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_LIVE_STRIPE_PUBLISHABLE_KEY

# Security & Governance Guardrails
DLP_STRICT_MODE=True
MAX_DOCUMENT_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=120
INVITE_TOKEN_EXPIRY_DAYS=7

# Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=True
AUDIT_LOG_IMMUTABLE=True
LOG_LEVEL=INFO
