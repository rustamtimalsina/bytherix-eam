# Environment Configuration
APP_ENV=development
APP_NAME="Bytherix EAM"
DEBUG=true
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bytherix_eam

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=bytherix-documents
S3_REGION=us-east-1

# AI & LLM Provider (Adapters for OpenAI, Gemini, Local)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
