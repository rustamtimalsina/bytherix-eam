# Copy this file to .env and fill in real values. NEVER commit .env.

# Must match the Postgres settings in compose.yaml
DATABASE_URL=postgresql+psycopg://bytherix:bytherix_dev_password@localhost:5432/bytherix

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON list of frontend origins allowed to call this API
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development

# Login rate limiting: failed attempts allowed inside the window before 429
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_WINDOW_MINUTES=15
